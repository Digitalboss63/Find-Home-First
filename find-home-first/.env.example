# PostgreSQL connection string — required for live database reads.
DATABASE_URL=

# Clerk authentication — required in production.
# Obtain from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk fallback redirect URLs (current convention — replaces AFTER_SIGN_IN/AFTER_SIGN_UP)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Platform administration.
PLATFORM_OWNER_CLERK_USER_ID=
# Optional comma-separated Clerk user IDs allowed to issue customer refunds/cancellations.
BILLING_SUPPORT_CLERK_USER_IDS=

# Canonical public application origin used for billing redirects.
APP_URL=https://www.findhomefirst.com

# Stripe subscription billing — server-side secrets only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Stripe price overrides. Defaults are defined in src/lib/billing.ts.
STRIPE_TIER1_PRICE_ID=
STRIPE_TIER2_PRICE_ID=

# Property inventory — required for live RentCast property search/opportunity inventory.
RENTCAST_API_KEY=

# Census ACS ZIP/ZCTA veteran demographics — required for ZIP-level Veteran Need differentiation.
# Request a free Census Data API key and store it only as a server-side secret.
CENSUS_API_KEY=

# Demo mode — set to "true" in development only. Never in production.
DEMO_MODE=